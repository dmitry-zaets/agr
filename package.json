{
  "name": "agr-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "extension",
    "packages/core"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test packages/core/test/*.test.ts scripts/test/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "npm --workspace extension run package",
    "test:extension": "npm run build && node extension/test/run.cjs",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "esbuild": "^0.25.0",
    "semantic-release": "^25.0.9",
    "semantic-release-vsce": "^6.1.8",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": "^22.14.0 || >=24.10.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dmitry-zaets/agr.git"
  }
}
